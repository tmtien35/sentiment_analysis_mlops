# ==============================================================================
# Cấu Hình Gửi Cảnh Báo Email Qua Gmail SMTP (Real-time Email Alerts)
# ==============================================================================
# 
# 📌 HƯỚNG DẪN 3 BƯỚC LẤY GMAIL APP PASSWORD (1 Phút):
# 1. Truy cập tài khoản Google của bạn: https://myaccount.google.com/
# 2. Vào mục "Bảo mật" (Security) -> Bật "Xác minh 2 bước" (2-Step Verification) nếu chưa bật.
# 3. Vào trực tiếp link tạo Mật khẩu ứng dụng: https://myaccount.google.com/apppasswords
#    - Đặt tên ứng dụng: MLOps Alert
#    - Bấm "Tạo" (Create) -> Google sẽ cấp mã 16 chữ cái (ví dụ: abcd efgh ijkl mnop).
# 4. Sao chép 16 chữ cái đó vào biến SMTP_PASSWORD dưới đây (xóa dấu cách nếu có).
#
# ==============================================================================

# Địa chỉ Gmail dùng để gửi cảnh báo (Chính là tài khoản Gmail của bạn)
SMTP_SENDER=your_email@gmail.com

# Mật khẩu ứng dụng 16 ký tự vừa tạo từ Google (KHÔNG PHẢI mật khẩu đăng nhập Gmail thường)
SMTP_PASSWORD=your_16_character_app_password

# Địa chỉ email nhận thông báo cảnh báo (Có thể trùng với SMTP_SENDER hoặc là email khác)
SMTP_RECIPIENT=tmtien35@gmail.com
